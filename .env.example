# Copy file ini jadi .env lalu isi. DATABASE_URL harus SAMA dengan .env bot-keuangan-telegram.
# TELEGRAM_TOKEN wajib ada karena config bot membutuhkannya (CLI tidak pernah memanggil Telegram API,
# jadi boleh pakai token yang sama dengan bot atau placeholder apa pun).
DATABASE_URL=sqlite+aiosqlite:///./finance_bot.db
TELEGRAM_TOKEN=isi-token-bot-di-sini
TELEGRAM_ID=1117819481
BOT_PATH=/home/ubuntu/Code/bot-keuangan-telegram
